# ================= WIFI =================

WIFI_SSID = "AI"
WIFI_PASSWORD = "12345678"


# ================= FIREBASE =================

DATABASE_URL = "h*******************m"

# Firebase Web API Key (optional for public database)
API_KEY = "A***********TXik"


# ================= FIREBASE USER =================

